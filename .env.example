# The default Demo uses no external AI calls or API credit.
AI_PROVIDER=memory
RAG_PROVIDER=memory
SCORING_PROVIDER=memory
# memory | openai | open_source
EXERCISE_PROVIDER=memory
# Main creative lesson agent. Defaults to EXERCISE_PROVIDER when omitted.
LESSON_PROVIDER=memory
# auto only calls the review agent for risk flags, warnings, or weak retrieval.
LESSON_REVIEW_MODE=auto
LESSON_REVIEW_PROVIDER=memory
PORT=3000

# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_SCORING_MODEL=
OPENAI_EXERCISE_MODEL=
OPENAI_LESSON_MODEL=
OPENAI_LESSON_REVIEW_MODEL=

# Required when EXERCISE_PROVIDER=open_source. Use an OpenAI-compatible
# Chat Completions base URL. API key may be blank for a trusted local server.
OPEN_SOURCE_LLM_BASE_URL=
OPEN_SOURCE_LLM_API_KEY=
OPEN_SOURCE_LLM_MODEL=
OPEN_SOURCE_LLM_JSON_MODE=true

# Required only when RAG_PROVIDER=openai.
OPENAI_VECTOR_STORE_ID=

# Use 127.0.0.1 for iOS Simulator. A physical phone needs the Mac's LAN address.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
